DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/certpilot?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Claude API key for question generation (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=""
# Comma-separated emails allowed to generate questions at /admin/generate
ADMIN_EMAILS=""

# Optional: "Use demo account" buttons on the sign-in page. Format: Label|email|password;Label|email|password
# Leave unset to hide them. Only ever point these at accounts holding sample data.
DEMO_LOGINS=
